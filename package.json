    "auto-maximize"
  ],
  "author": "FideFei",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/FideFei/dsh-auto-maximize.git"
  },
  "homepage": "https://gitee.com/FideFei/dsh-auto-maximize",
  "bugs": {
    "url": "https://gitee.com/FideFei/dsh-auto-maximize/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
